<div id="app" x-data="scannerApp()" x-init="init()">
  
  <!-- 顶部导航（sticky，QR 扫描框也在里面） -->
  <header class="header" :class="{ 'has-qr-bar': confirmationId && confirmation?.status !== 'confirmed' && confirmation?.status !== 'pending_signature' }">
    <nav>
      <!-- Back button (only visible during verify) -->
      <button class="nav-btn nav-back" x-show="confirmationId" @click="backToNotice()">
        ← <span x-text="t('backToNotice')"></span>
      </button>
      <a href="/" class="nav-btn nav-active"><span x-text="t('navScan')"></span></a>
      <a href="/history" class="nav-btn"><span x-text="t('navHistory')"></span></a>
      <a href="#" @click.prevent="toggleLang()" class="nav-btn lang-btn">
        <span x-text="lang === 'en' ? '🇨🇳 中文' : '🇬🇧 English'"></span>
      </a>
    </nav>
    <!-- 扫码输入区（嵌入 header，跟随 sticky 固定在顶部） -->
    <div class="scan-control-bar" x-show="confirmationId && confirmation?.status !== 'confirmed' && confirmation?.status !== 'pending_signature'">
      <input type="text" 
             x-ref="qrInput" 
             x-model="scanQR" 
             @keyup.enter="doQRScan()"
             :placeholder="t('qrPlaceholder')"
             class="qr-input"
             autocomplete="off"
             autocorrect="off"
             autocapitalize="off"
             spellcheck="false">
    </div>
  </header>

  <!-- 查询出货通知（比对模式下隐藏） -->
  <section class="section" id="search-section" x-show="!confirmationId">
    <h2 x-text="t('searchTitle')"></h2>
    <div class="form-row">
      <input type="text" x-model="searchInput" @keyup.enter="searchNotice()" 
             :placeholder="t('searchPlaceholder')">
      <button @click="searchNotice()" :disabled="searching">
        <span x-show="!searching" x-text="t('searchBtn')"></span>
        <span x-show="searching" x-text="t('searching')"></span>
      </button>
    </div>
    <div class="hint" x-text="t('searchHint')"></div>
    
    <div class="error-box" x-show="searchError" x-cloak>
      <div x-show="searchErrorType === 'not_found'" class="error-icon">🔍</div>
      <div x-show="searchErrorType === 'already_confirmed'" class="error-icon">🔒</div>
      <div x-show="searchErrorType !== 'not_found' && searchErrorType !== 'already_confirmed'" class="error-icon">⚠️</div>
      <span x-text="searchError"></span>
    </div>
  </section>

  <!-- 出货通知详情 + 确认启动 -->
  <section class="section" id="notice-section" x-show="notice && !confirmationId" x-cloak>
    <div class="notice-card">
      <div class="notice-header">
        <h3>PickList #<span x-text="notice?.PickListId"></span></h3>
        <span class="badge" :class="notice?.SiteRef === '410' ? 'badge-410' : notice?.SiteRef === '310' ? 'badge-310' : 'badge-330'">
          Site: <span x-text="notice?.SiteRef"></span>
        </span>
      </div>
      <div class="notice-meta">
        <div><strong x-text="t('customer')"></strong> <span x-text="notice?.cust_name"></span><template x-if="notice?.drop_cust_name && notice.drop_cust_name !== notice.cust_name"><span style="color:#64748b;font-size:0.85em;margin-left:4px;">(<span x-text="notice.drop_cust_name"></span>)</span></template></div>
        <div><strong x-text="t('shipDate')"></strong> <span x-text="formatDate(notice?.due_date)"></span></div>
        <div><strong x-text="t('shipMethod')"></strong> <span x-text="notice?.ship_code"></span></div>
        <div><strong x-text="t('totalCartons')"></strong> <span x-text="notice?.total_cartons"></span> <span x-text="t('cartons')"></span></div>
      </div>

    </div>

    <!-- 进行中提示 -->
    <div class="resume-banner" x-show="inProgressId" x-cloak>
      <div class="resume-icon">⏸️</div>
      <div class="resume-info">
        <div class="resume-title" x-text="t('resumeTitle')"></div>
        <div class="resume-progress">
          <span x-text="t('scannedQty') + ': ' + (inProgressScanned || 0) + ' / ' + (inProgressTotal || 0)"></span>
        </div>
      </div>
    </div>

    <div class="action-row">
      <template x-if="inProgressId">
        <div style="display:flex;gap:0.5rem;width:100%">
          <button class="btn-primary" @click="resumeConfirmation(inProgressId)" :disabled="starting">
            <span x-show="!starting" x-text="t('resumeConfirm')"></span>
            <span x-show="starting" x-text="t('starting')"></span>
          </button>
          <button class="btn-danger" @click="restartConfirmation()" :disabled="starting" x-text="t('restartConfirm')"></button>
        </div>
      </template>
      <template x-if="!inProgressId">
        <div style="display:flex;gap:0.5rem;width:100%">
          <button class="btn-primary" @click="startConfirmation()" :disabled="starting">
            <span x-show="!starting" x-text="t('startConfirm')"></span>
            <span x-show="starting" x-text="t('starting')"></span>
          </button>
          <button @click="reset()" x-text="t('cancel')"></button>
        </div>
      </template>
    </div>
  </section>

  <!-- 比对界面 -->
  <section class="section" id="scan-section" x-show="confirmationId" x-cloak>
    
    <!-- 状态头部 -->
    <div class="status-header" :class="{ 'status-completed': confirmation?.status === 'confirmed' || confirmation?.status === 'pending_signature' }">
      <div class="status-title">
        <span x-show="confirmation?.status !== 'confirmed' && confirmation?.status !== 'pending_signature'" x-text="t('verifying')"></span>
        <span x-show="confirmation?.status === 'pending_signature'" x-text="t('pendingSignature')"></span>
        <span x-show="confirmation?.status === 'confirmed'" x-text="t('completed')"></span>
      </div>
    </div>

    <!-- 最近扫码结果 -->
    <div class="scan-feedback" x-show="lastScanResult" :class="lastScanResult?.success ? 'success' : 'error'" x-cloak>
      <template x-if="lastScanResult?.success">
        <div>
          ✅ <span x-text="t('scanSuccess')"></span>
          <span x-text="' — ' + t('wo') + ': ' + (lastScanResult?.wo || '-') + ', ' + t('qty') + ': ' + (lastScanResult?.scanned_qty || 0)"></span>
          <span x-show="lastScanResult?.over_qty" class="over-qty-warn"> ⚠️ <span x-text="t('overQty')"></span></span>
          <div class="scan-detail">
            <span x-text="t('verifiedRows') + ': ' + (lastScanResult.summary?.verifiedRows || 0) + '/' + (lastScanResult.summary?.totalRows || 0)"></span>
            <span x-text="' | ' + t('totalVerifiedQty') + ': ' + (lastScanResult.summary?.totalScannedQty || 0)"></span>
          </div>
        </div>
      </template>
      <template x-if="!lastScanResult?.success">
        <div>
          ❌ <span x-text="lastScanResult?.error || t('scanFailed')"></span>
          <span x-show="lastScanResult?.wo" x-text="' — ' + t('wo') + ': ' + (lastScanResult?.wo || '-')"></span>
        </div>
      </template>
    </div>

    <!-- 比对明细卡片 -->
    <div class="compare-cards-wrap" x-show="items.length > 0">
      <h4 x-text="t('compareTitle')"></h4>
      <div class="compare-cards">
        <template x-for="(item, idx) in items" :key="item.id || idx">
          <div class="v-card" :class="{ 'v-card-done': getItemVerified(item), 'v-card-over': getItemOverQty(item) }">
            <!-- 状态角标 -->
            <div class="v-card-status-badge">
              <template x-if="getItemVerified(item)"><span class="v-badge v-badge-ok">✅ Verified</span></template>
              <template x-if="!getItemVerified(item) && item.scanned_qty > 0"><span class="v-badge v-badge-partial">⏳ Partial</span></template>
              <template x-if="!getItemVerified(item) && !(item.scanned_qty > 0)"><span class="v-badge v-badge-pending">⏸ Pending</span></template>
            </div>
            <!-- 字段列表 -->
            <div class="v-field-list">
              <div class="v-field-row">
                <span class="v-field-label">SEQ</span>
                <span class="v-field-val" x-text="item.sequence"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label">SO</span>
                <span class="v-field-val v-field-code" x-text="item.ref_num || '-'"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label">WO</span>
                <span class="v-field-val v-field-code" x-text="item.wo_number || '-'"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label">PART</span>
                <span class="v-field-val v-field-code v-field-part" x-text="item.item_code || '-'"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label">LOCATION</span>
                <span class="v-field-val v-field-desc" x-text="item.location || '-'"></span>
              </div>
              <div class="v-field-divider"></div>
              <div class="v-field-row">
                <span class="v-field-label" x-text="t('colShipQty')"></span>
                <span class="v-field-val v-field-num" x-text="item.qty_to_pick"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label" x-text="t('colVerifiedQty')"></span>
                <span class="v-field-val v-field-num" :class="getItemVerified(item) ? 'text-green' : (item.scanned_qty > 0 ? 'text-yellow' : '')" x-text="item.scanned_qty || 0"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label" x-text="t('colUnverifiedQty')"></span>
                <span class="v-field-val v-field-num" :class="getUnverifiedQty(item) > 0 ? 'text-red' : 'text-green'" x-text="getUnverifiedQty(item)"></span>
              </div>
              <div class="v-field-row">
                <span class="v-field-label">BOX</span>
                <span class="v-field-val v-field-num" x-text="item.scanned_boxes || 0"></span>
              </div>
            </div>
          </div>
        </template>
      </div>
      <!-- 汇总卡片 -->
      <div class="v-card v-card-summary" x-show="summary">
        <div class="v-field-list">
          <div class="v-field-row v-field-row-bold">
            <span class="v-field-label" x-text="t('totalShipQty')"></span>
            <span class="v-field-val v-field-num" x-text="summary?.totalShipQty || 0"></span>
          </div>
          <div class="v-field-row v-field-row-bold">
            <span class="v-field-label" x-text="t('totalVerifiedQty')"></span>
            <span class="v-field-val v-field-num" :class="{ 'text-green': summary?.totalScannedQty === summary?.totalShipQty }" x-text="summary?.totalScannedQty || 0"></span>
          </div>
          <div class="v-field-row v-field-row-bold">
            <span class="v-field-label" x-text="t('totalUnverifiedQty')"></span>
            <span class="v-field-val v-field-num" :class="(summary?.totalUnverifiedQty || 0) > 0 ? 'text-red' : 'text-green'" x-text="summary?.totalUnverifiedQty || 0"></span>
          </div>
          <div class="v-field-divider"></div>
          <div class="v-field-row">
            <span class="v-field-label" x-text="t('verifiedRows')"></span>
            <span class="v-field-val" :class="summary?.verifiedRows >= summary?.totalRows ? 'text-green' : 'text-yellow'">
              <span x-text="(summary?.verifiedRows || 0) + '/' + (summary?.totalRows || 0)"></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 数量不匹配提示 -->
    <div class="mismatch-warning" x-show="qtyMismatch && confirmation?.status !== 'confirmed'" x-cloak>
      ⚠️ <span x-text="t('qtyMismatch')"></span>
    </div>

    <!-- 签名提示 / 完成按钮 -->
    <div class="action-row" x-show="confirmation?.status === 'pending_signature' || confirmation?.status === 'confirmed'">
      <template x-if="confirmation?.status === 'pending_signature'">
        <div class="sign-prompt">
          <div class="sign-prompt-message">
            📝 <span x-text="t('signRequired')"></span>
          </div>
          <button class="btn-primary" @click="showSignModal = true"><span x-text="t('openSignPad')"></span></button>
        </div>
      </template>
      <template x-if="confirmation?.status === 'confirmed'">
        <div>
          <div class="completed-message">
            🎉 <span x-text="t('notifyDone')"></span> <strong x-text="notice?.PickListId"></strong> <span x-text="t('confirmed')"></span>！
            <div class="sign-info" x-show="confirmation?.signed_by">
              ✍️ <span x-text="t('signedBy')"></span> <strong x-text="confirmation?.signed_by"></strong>
            </div>
          </div>
          <button class="btn-primary" @click="reset()"><span x-text="t('nextSearch')"></span></button>
        </div>
      </template>
    </div>

    <!-- 签名 Modal -->
    <div class="sign-modal-overlay" x-show="showSignModal" x-cloak @click.self="showSignModal = false">
      <div class="sign-modal">
        <h3 x-text="t('signTitle')"></h3>
        <div class="sign-name-row">
          <label x-text="t('signerName')"></label>
          <input type="text" x-model="signedBy" :placeholder="t('signerPlaceholder')">
        </div>
        <div class="sign-canvas-wrap">
          <canvas id="signature-pad" width="500" height="200"></canvas>
        </div>
        <div class="sign-actions">
          <button @click="clearSignature()" x-text="t('clearSignature')"></button>
          <button class="btn-primary" @click="submitSignature()" :disabled="submittingSignature || !signedBy.trim()">
            <span x-show="!submittingSignature" x-text="t('confirmSignature')"></span>
            <span x-show="submittingSignature" x-text="t('submitting')"></span>
          </button>
        </div>
        <div class="sign-error" x-show="signError" x-text="signError"></div>
      </div>
    </div>
  </section>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
<script src="https://unpkg.com/alpinejs@3/dist/cdn.min.js" defer></script>
