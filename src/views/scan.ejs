function scannerApp() {
  return {
    lang: 'en',

    t(key, vars) {
      let text = translations[this.lang]?.[key] || translations.en[key] || key;
      if (vars) {
        for (const [k, v] of Object.entries(vars)) {
          text = text.replace(`{${k}}`, v);
        }
      }
      return text;
    },

    toggleLang() {
      this.lang = this.lang === 'en' ? 'zh' : 'en';
      localStorage.setItem('shippingLang', this.lang);
    },

    searchInput: '',
    searching: false,
    searchError: '',
    searchErrorType: '',
    notice: null,
    items: [],
    starting: false,

    confirmationId: null,
    confirmation: null,
    scanQR: '',
    qtyMismatch: false,
    summary: null,

    // 进行中的已有确认（断点续扫）
    inProgressId: null,
    inProgressScanned: 0,
    inProgressTotal: 0,

    lastScanResult: null,
    feedbackTimer: null,

    // signature
    showSignModal: false,
    signedBy: '',
    signError: '',
    submittingSignature: false,
    signaturePad: null,

    socket: null,
    _scanResultHandler: null,
    _progressUpdateHandler: null,

    init() {
      const saved = localStorage.getItem('shippingLang');
      if (saved === 'zh') this.lang = 'zh';

      this.socket = io({ transports: ['polling', 'websocket'] });
      this.socket.on('connect', () => console.log('[Socket] Connected'));
      this.socket.on('disconnect', () => console.log('[Socket] Disconnected'));

      // 处理来自历史记录页的 resumeId 参数
      const urlParams = new URLSearchParams(window.location.search);
      const resumeId = urlParams.get('resumeId');
      if (resumeId) {
        window.history.replaceState({}, '', '/');
        this.resumeConfirmation(parseInt(resumeId));
      }
    },

    async searchNotice() {
      if (!this.searchInput.trim()) return;
      this.searching = true;
      this.searchError = '';
      this.searchErrorType = '';
      this.inProgressId = null;
      this.inProgressScanned = 0;
      this.inProgressTotal = 0;
      try {
        const res = await fetch(`/api/notices/${encodeURIComponent(this.searchInput.trim())}`);
        const json = await res.json();
        if (json.success) {
          if (!json.data.notice) {
            this.notice = null;
            this.items = [];
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
            return;
          }
          this.notice = json.data.notice;
          this.items = json.data.items;

          this.searchError = '';
          this.searchErrorType = '';

          // 检查是否有进行中的确认记录
          try {
            const chkRes = await fetch(`/api/confirmations/by-picklist/${encodeURIComponent(this.searchInput.trim())}`);
            const chkJson = await chkRes.json();
            if (chkJson.success && chkJson.data && (chkJson.data.status === 'in_progress' || chkJson.data.status === 'pending_signature')) {
              this.inProgressId = chkJson.data.id;
              this.inProgressScanned = chkJson.data.total_scanned_qty || 0;
              this.inProgressTotal = chkJson.data.total_ship_qty || 0;
            }
          } catch (e) {}

        } else {
          this.notice = null;
          this.items = [];
          if (json.error === 'not_found') {
            try {
              const chkRes = await fetch(`/api/confirmations/by-picklist/${encodeURIComponent(this.searchInput.trim())}`);
              const chkJson = await chkRes.json();
              if (chkJson.success && chkJson.data && (chkJson.data.status === 'in_progress' || chkJson.data.status === 'pending_signature')) {
                this.inProgressId = chkJson.data.id;
                this.inProgressScanned = chkJson.data.total_scanned_qty || 0;
                this.inProgressTotal = chkJson.data.total_ship_qty || 0;
                return;
              }
            } catch (e) {}
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
          } else {
            this.searchError = json.message || json.error || 'Search failed';
            this.searchErrorType = 'error';
          }
        }
      } catch (err) {
        this.searchError = this.lang === 'zh' ? '网络错误: ' + err.message : 'Network error: ' + err.message;
        this.searchErrorType = 'error';
        this.notice = null;
      } finally {
        this.searching = false;
      }
    },

    async startConfirmation() {
      this.starting = true;
      try {
        const res = await fetch('/api/confirmations/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: this.notice.PickListId, operator: 'operator' }),
        });
        const json = await res.json();
        if (json.success) {
          this.confirmation = {
            ...json.notice,
            id: json.confirmationId,
            total_cartons: parseInt(json.notice.total_cartons),
            scanned_boxes: 0,
            total_scanned_qty: 0,
            total_ship_qty: json.items.reduce((s, i) => s + (parseFloat(i.qty_to_pick) || 0), 0),
            status: 'in_progress',
          };
          this.items = json.items.map(i => ({ ...i, scanned_qty: 0, scanned_boxes: 0 }));
          this.summary = this.calcSummary(this.items);
          this._enterScanMode(json.confirmationId);
        } else {
          if (json.error === 'already_confirmed') {
            this.searchError = this.t('alreadyConfirmed');
            this.searchErrorType = 'already_confirmed';
            this.notice = null;
            this.items = [];
          } else if (json.error === 'not_found') {
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
            this.notice = null;
            this.items = [];
          } else if (json.error === 'in_progress' && json.confirmationId) {
            this.inProgressId = json.confirmationId;
            this.inProgressScanned = json.scanned || 0;
            this.inProgressTotal = json.total || 0;
          } else {
            alert(json.message || json.error);
          }
        }
      } catch (err) {
        alert(this.lang === 'zh' ? '启动失败: ' + err.message : 'Failed: ' + err.message);
      } finally {
        this.starting = false;
      }
    },

    async resumeConfirmation(confirmationId) {
      this.starting = true;
      try {
        const res = await fetch(`/api/confirmations/${confirmationId}`);
        const json = await res.json();
        if (json.success) {
          this.confirmation = json.data.confirmation;
          this.items = json.data.items;
          this.summary = this.calcSummary(this.items);
          this.qtyMismatch = this.checkQtyMismatch();
          if (this.confirmation.status === 'pending_signature') {
            this.$nextTick(() => this.initSignaturePad());
          }
          this._enterScanMode(confirmationId);
        } else {
          alert(json.error || 'Resume failed');
        }
      } catch (err) {
        alert(err.message);
      } finally {
        this.starting = false;
      }
    },

    async restartConfirmation() {
      const msg = this.lang === 'zh'
        ? '确认要丢弃已有进度，从头开始吗？'
        : 'Discard existing progress and restart from scratch?';
      if (!confirm(msg)) return;
      if (this.inProgressId) {
        try {
          await fetch(`/api/confirmations/${this.inProgressId}/cancel`, { method: 'POST' });
        } catch (e) {}
      }
      location.reload();
    },

    _enterScanMode(confirmationId) {
      this.confirmationId = confirmationId;
      this.inProgressId = null;
      this.$nextTick(() => {
        if (this.$refs.qrInput) this.$refs.qrInput.focus();
      });
      this.socket.emit('join-confirmation', confirmationId);
      if (this._scanResultHandler) this.socket.off('scan-result', this._scanResultHandler);
      if (this._progressUpdateHandler) this.socket.off('progress-update', this._progressUpdateHandler);
      this._scanResultHandler = (result) => this.handleScanResult(result);
      this._progressUpdateHandler = (data) => this.handleProgressUpdate(data);
      this.socket.on('scan-result', this._scanResultHandler);
      this.socket.on('progress-update', this._progressUpdateHandler);
    },

    backToNotice() {
      if (this.socket) {
        if (this._scanResultHandler) this.socket.off('scan-result', this._scanResultHandler);
        if (this._progressUpdateHandler) this.socket.off('progress-update', this._progressUpdateHandler);
      }
      if (this.confirmationId && this.confirmation?.status !== 'confirmed') {
        this.inProgressId = this.confirmationId;
        this.inProgressScanned = this.confirmation?.total_scanned_qty || 0;
        this.inProgressTotal = this.confirmation?.total_ship_qty || 0;
      }
      this.confirmationId = null;
      this.confirmation = null;
      this.scanQR = '';
      this.lastScanResult = null;
      this.qtyMismatch = false;
      this.summary = null;
      this.showSignModal = false;
    },

    parseQRData(text) {
      // Parse QR code text like: CUST. P/N:G8020-60091;...WO:J000032579;QUANTITY:15;...PACKING COUNT:OF
      const woMatch = text.match(/WO:([^;]+)/i);
      const qtyMatch = text.match(/QUANTITY:([^;]+)/i);
      return {
        wo: woMatch ? woMatch[1].trim() : null,
        quantity: qtyMatch ? qtyMatch[1].trim() : null,
      };
    },

    doQRScan() {
      const qrText = this.scanQR.trim();
      if (!qrText || !this.confirmationId) return;

      const parsed = this.parseQRData(qrText);
      if (!parsed.wo || !parsed.quantity) {
        this.lastScanResult = { success: false, error: this.lang === 'zh' ? '无法识别二维码，请重试' : 'Cannot parse QR code, please try again' };
        if (this.feedbackTimer) clearTimeout(this.feedbackTimer);
        this.feedbackTimer = setTimeout(() => { this.lastScanResult = null; }, 3000);
        this.scanQR = '';
        this.$nextTick(() => { if (this.$refs.qrInput) this.$refs.qrInput.focus(); });
        return;
      }

      this.socket.emit('scan-barcode', { 
        confirmationId: this.confirmationId, 
        woNumber: parsed.wo, 
        quantity: parsed.quantity 
      });

      // 清空输入，焦点保持在扫码框
      this.scanQR = '';
      this.$nextTick(() => {
        if (this.$refs.qrInput) this.$refs.qrInput.focus();
      });
    },

    handleScanResult(result) {
      this.lastScanResult = result;
      this.playFeedback(result.success);
      if (this.feedbackTimer) clearTimeout(this.feedbackTimer);
      this.feedbackTimer = setTimeout(() => { this.lastScanResult = null; }, 3000);
    },

    handleProgressUpdate(data) {
      this.confirmation = data.confirmation;
      this.items = data.items;
      this.summary = data.summary || this.calcSummary(data.items);
      this.qtyMismatch = this.checkQtyMismatch();
      if (data.confirmation.status === 'pending_signature') {
        this.$nextTick(() => this.initSignaturePad());
      }
      if (data.confirmation.status === 'confirmed') this.playAllComplete();
    },

    // 辅助方法：计算前端 summary
    calcSummary(items) {
      if (!items || !items.length) return null;
      let totalShipQty = 0, totalScannedQty = 0, verifiedRows = 0, totalScannedBoxes = 0;
      const totalRows = items.length;

      // 按 WO 分组
      const woGroups = {};
      for (const item of items) {
        const woKey = item.wo_number || `__no_wo_${item.id}`;
        if (!woGroups[woKey]) woGroups[woKey] = [];
        woGroups[woKey].push(item);
        totalShipQty += parseFloat(item.qty_to_pick) || 0;
        totalScannedQty += parseFloat(item.scanned_qty) || 0;
        totalScannedBoxes += parseInt(item.scanned_boxes) || 0;
      }

      for (const [woKey, group] of Object.entries(woGroups)) {
        const groupTotalShip = group.reduce((s, i) => s + (parseFloat(i.qty_to_pick) || 0), 0);
        const groupTotalScanned = group.reduce((s, i) => s + (parseFloat(i.scanned_qty) || 0), 0);
        if (groupTotalScanned >= groupTotalShip) {
          verifiedRows += group.length;
        } else {
          for (const item of group) {
            if ((parseFloat(item.scanned_qty) || 0) >= (parseFloat(item.qty_to_pick) || 0)) {
              verifiedRows++;
            }
          }
        }
      }

      return {
        totalShipQty: Math.round(totalShipQty * 100) / 100,
        totalScannedQty: Math.round(totalScannedQty * 100) / 100,
        totalUnverifiedQty: Math.round((totalShipQty - totalScannedQty) * 100) / 100,
        verifiedRows,
        totalRows,
        totalScannedBoxes,
      };
    },

    // 检查数量是否不匹配（总量对比）
    checkQtyMismatch() {
      if (!this.items || !this.items.length) return false;
      const totalShip = this.items.reduce((s, i) => s + (parseFloat(i.qty_to_pick) || 0), 0);
      const totalScanned = this.items.reduce((s, i) => s + (parseFloat(i.scanned_qty) || 0), 0);
      return Math.abs(totalScanned - totalShip) > 0.001;
    },

    getItemVerified(item) {
      return (parseFloat(item.scanned_qty) || 0) >= (parseFloat(item.qty_to_pick) || 0);
    },

    getItemOverQty(item) {
      return (parseFloat(item.scanned_qty) || 0) > (parseFloat(item.qty_to_pick) || 0);
    },

    getUnverifiedQty(item) {
      const ship = parseFloat(item.qty_to_pick) || 0;
      const scanned = parseFloat(item.scanned_qty) || 0;
      return Math.round((ship - scanned) * 100) / 100;
    },

    playFeedback(success) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination); gain.gain.value = 0.1;
        osc.frequency.value = success ? 880 : 440;
        osc.start(); osc.stop(ctx.currentTime + (success ? 0.1 : 0.2));
      } catch (e) {}
    },

    playAllComplete() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        [523, 659, 784].forEach((freq, i) => {
          const osc = ctx.createOscillator(); const gain = ctx.createGain();
          osc.connect(gain); gain.connect(ctx.destination); gain.gain.value = 0.1;
          osc.frequency.value = freq;
          osc.start(ctx.currentTime + i * 0.15);
          osc.stop(ctx.currentTime + i * 0.15 + 0.2);
        });
      } catch (e) {}
    },

    formatDate(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      return this.lang === 'zh' ? d.toLocaleDateString('zh-CN') : d.toLocaleDateString('en-US');
    },

    initSignaturePad() {
      this.$nextTick(() => {
        const canvas = document.getElementById('signature-pad');
        if (!canvas) return;
        if (this.signaturePad) { this.signaturePad.off(); this.signaturePad = null; }
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = canvas.offsetHeight * ratio;
        canvas.getContext('2d').scale(ratio, ratio);
        this.signaturePad = new SignaturePad(canvas, {
          backgroundColor: 'rgb(255,255,255)',
          penColor: 'rgb(0,0,0)',
        });
      });
    },

    clearSignature() {
      if (this.signaturePad) this.signaturePad.clear();
    },

    async submitSignature() {
      if (!this.signaturePad || this.signaturePad.isEmpty()) {
        this.signError = this.lang === 'zh' ? '请先签名' : 'Please sign first';
        return;
      }
      if (!this.signedBy.trim()) {
        this.signError = this.lang === 'zh' ? '请输入签名者姓名' : 'Please enter signer name';
        return;
      }
      this.submittingSignature = true;
      this.signError = '';
      try {
        const signature = this.signaturePad.toDataURL('image/png');
        const res = await fetch(`/api/confirmations/${this.confirmationId}/sign`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signature, signedBy: this.signedBy.trim() }),
        });
        const json = await res.json();
        if (json.success) {
          this.confirmation.status = 'confirmed';
          this.confirmation.signed_by = this.signedBy.trim();
          this.showSignModal = false;
          this.playAllComplete();
        } else {
          this.signError = json.error || 'Save failed';
        }
      } catch (err) {
        this.signError = err.message;
      } finally {
        this.submittingSignature = false;
      }
    },

    reset() {
      if (this.socket) {
        this.socket.off('scan-result');
        this.socket.off('progress-update');
      }
      this.searchInput = '';
      this.notice = null;
      this.items = [];
      this.confirmationId = null;
      this.confirmation = null;
      this.scanQR = '';
      this.qtyMismatch = false;
      this.summary = null;
      this.lastScanResult = null;
      this.searchError = '';
      this.searchErrorType = '';
      this.inProgressId = null;
      this.inProgressScanned = 0;
      this.inProgressTotal = 0;
      this.showSignModal = false;
      this.signedBy = '';
      this.signError = '';
      this.submittingSignature = false;
      if (this.signaturePad) { this.signaturePad.off(); this.signaturePad = null; }
    },
  };
}
</script>

