<div id="app" x-data="scannerApp()" x-init="init()">
  
  <!-- 顶部导航 -->
  <header class="header">
    <h1>📦 <span x-text="t('siteTitle')"></span></h1>
    <nav>
      <!-- 站点选择器 -->
      <select x-model="currentSite" @change="onSiteChange()" class="nav-btn site-select">
        <option value="">All Sites</option>
        <option value="410">Site 410</option>
        <option value="310">Site 310</option>
        <option value="330">Site 330</option>
      </select>
      <a href="/" class="nav-btn nav-active"><span x-text="t('navScan')"></span></a>
      <a href="/history" class="nav-btn"><span x-text="t('navHistory')"></span></a>
      <a href="#" @click.prevent="toggleLang()" class="nav-btn lang-btn">
        <span x-text="lang === 'en' ? '🇨🇳 中文' : '🇬🇧 English'"></span>
      </a>
    </nav>
  </header>

  <!-- 查询出货通知 -->
  <section class="section" id="search-section">
    <h2 x-text="t('searchTitle')"></h2>
    <div class="form-row">
      <input type="text" x-model="searchInput" @keyup.enter="searchNotice()" 
             :placeholder="t('searchPlaceholder')">
      <button @click="searchNotice()" :disabled="searching">
        <span x-show="!searching" x-text="t('searchBtn')"></span>
        <span x-show="searching" x-text="t('searching')"></span>
      </button>
    </div>
    <div class="hint" x-text="t('searchHint')"></div>
    
    <div class="error-box" x-show="searchError" x-cloak>
      <div x-show="searchErrorType === 'not_found'" class="error-icon">🔍</div>
      <div x-show="searchErrorType === 'already_confirmed'" class="error-icon">🔒</div>
      <div x-show="searchErrorType !== 'not_found' && searchErrorType !== 'already_confirmed'" class="error-icon">⚠️</div>
      <span x-text="searchError"></span>
    </div>
  </section>

  <!-- 出货通知详情 + 确认启动 -->
  <section class="section" id="notice-section" x-show="notice" x-cloak>
    <div class="notice-card">
      <div class="notice-header">
        <h3>PickList #<span x-text="notice?.PickListId"></span></h3>
        <span class="badge" :class="notice?.SiteRef === '410' ? 'badge-410' : notice?.SiteRef === '310' ? 'badge-310' : 'badge-330'">
          Site: <span x-text="notice?.SiteRef"></span>
        </span>
      </div>
      <div class="notice-meta">
        <div><strong x-text="t('customer')"></strong> <span x-text="notice?.cust_name"></span></div>
        <div><strong x-text="t('shipDate')"></strong> <span x-text="formatDate(notice?.due_date)"></span></div>
        <div><strong x-text="t('shipMethod')"></strong> <span x-text="notice?.ship_code"></span></div>
        <div><strong x-text="t('totalCartons')"></strong> <span x-text="notice?.total_cartons"></span> <span x-text="t('cartons')"></span></div>
      </div>
    </div>

    <!-- 品项列表 -->
    <div class="items-preview" x-show="items.length > 0">
      <h4><span x-text="t('itemsTitle')"></span> (<span x-text="items.length"></span> <span x-text="t('items')"></span>)</h4>
      <table class="items-table">
        <thead>
          <tr>
            <th x-text="t('colSeq')"></th>
            <th>RefNum</th>
            <th x-text="t('colPartNo')"></th>
            <th x-text="t('colPartName')"></th>
            <th x-text="t('colQty')"></th>
            <th x-text="t('colCartons')"></th>
          </tr>
        </thead>
        <tbody>
          <template x-for="(item, idx) in items" :key="idx">
            <tr>
              <td x-text="item.Sequence"></td>
              <td x-text="item.RefNum"></td>
              <td class="code-cell" x-text="item.item_code"></td>
              <td x-text="item.item_name"></td>
              <td><span x-text="item.qty_to_pick"></span> <span x-text="item.um"></span></td>
              <td class="highlight"><span x-text="item.planned_boxes"></span> <span x-text="t('cartons')"></span></td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <div class="action-row">
      <button class="btn-primary" @click="startConfirmation()" :disabled="starting">
        <span x-show="!starting" x-text="t('startConfirm')"></span>
        <span x-show="starting" x-text="t('starting')"></span>
      </button>
      <button @click="reset()" x-text="t('cancel')"></button>
    </div>
  </section>

  <!-- 扫码界面 -->
  <section class="section" id="scan-section" x-show="confirmationId" x-cloak>
    
    <!-- 状态头部 -->
    <div class="status-header" :class="{ 'status-completed': confirmation?.status === 'confirmed' || confirmation?.status === 'pending_signature' }">
      <div class="status-title">
        <span x-show="confirmation?.status !== 'confirmed' && confirmation?.status !== 'pending_signature'" x-text="t('scanning')"></span>
        <span x-show="confirmation?.status === 'pending_signature'" x-text="t('pendingSignature')"></span>
        <span x-show="confirmation?.status === 'confirmed'" x-text="t('completed')"></span>
      </div>
      <div class="status-progress">
        <div class="progress-bar">
          <div class="progress-fill" 
               :style="'width: ' + getProgressPercent() + '%'"></div>
        </div>
        <span class="progress-text">
          <span x-text="confirmation?.scanned_boxes || 0"></span> / 
          <span x-text="confirmation?.total_cartons || 0"></span> <span x-text="t('cartons')"></span>
        </span>
      </div>
    </div>

    <!-- 当前品项 -->
    <div class="current-item" x-show="currentItem">
      <div class="current-item-header">
        <span class="item-label" x-text="t('currentItem')"></span>
        <span class="item-badge" :class="currentItem?.status === 'completed' ? 'badge-done' : 'badge-active'">
          <span x-text="currentItem?.status === 'completed' ? t('done') : t('inProgress')"></span>
        </span>
      </div>
      <div class="current-item-body">
        <div class="item-code" x-text="currentItem?.item_code"></div>
        <div class="item-name" x-text="currentItem?.item_name"></div>
        <div class="item-meta" x-show="currentItem?.wo_number">
          <span x-text="t('wo')"></span>: <span x-text="currentItem.wo_number"></span>
        </div>
        <div class="item-progress">
          <span x-text="currentItem?.scanned_boxes || 0"></span> / 
          <span x-text="currentItem?.planned_boxes"></span> <span x-text="t('cartons')"></span>
          <span x-show="currentItem?.wo_number"> | <span x-text="t('expectBox')"></span> <span x-text="currentItem?.scanned_boxes + 1"></span></span>
        </div>
        <div class="progress-bar progress-small">
          <div class="progress-fill" 
               :style="'width: ' + (currentItem ? (currentItem.scanned_boxes / currentItem.planned_boxes * 100) : 0) + '%'"></div>
        </div>
      </div>
    </div>

    <!-- 扫码输入 -->
    <div class="scan-input-area" x-show="!allCompleted">
      <div class="scan-input-row">
        <input type="text" 
               x-ref="barcodeInput" 
               x-model="barcode" 
               @keyup.enter="doScan()" 
               autofocus
               :placeholder="t('scanPlaceholder')"
               :disabled="allCompleted"
               class="scan-input"
               autocomplete="off"
               autocorrect="off"
               autocapitalize="off"
               spellcheck="false">
        <button @click="doScan()" :disabled="allCompleted || !barcode.trim()">
          <span x-text="t('confirm')"></span>
        </button>
      </div>
    </div>

    <!-- 最近扫码结果 -->
    <div class="scan-feedback" x-show="lastScanResult" :class="lastScanResult?.success ? 'success' : 'error'" x-cloak>
      <template x-if="lastScanResult?.success">
        <div>
          ✅ <span x-text="t('scanSuccess') + (lastScanResult?.confirm_id ? ' #' + lastScanResult.confirm_id : '')"></span>
          <div class="scan-detail" x-show="lastScanResult?.qrInfo">
            <div>
              <template x-if="lastScanResult?.qrInfo?.boxNum">
                📦 <code x-text="lastScanResult.qrInfo.boxNum + '/' + lastScanResult.qrInfo.totalBoxes + ' ' + t('cartons')"></code>
              </template>
              <template x-if="!lastScanResult?.qrInfo?.boxNum">
                📦 <span x-text="t('singleCarton')"></span>
              </template>
              <span x-show="lastScanResult?.qrInfo?.dateCode"> | <span x-text="t('dateCode')"></span>: <span x-text="lastScanResult.qrInfo.dateCode"></span></span>
              <span x-show="lastScanResult?.qrInfo?.wo"> | <span x-text="t('wo')"></span>: <span x-text="lastScanResult.qrInfo.wo"></span></span>
            </div>
            <template x-if="lastScanResult?.item">
              <div>
                <span x-text="t('progress')"></span>: <span x-text="lastScanResult.item.scanned_boxes"></span>/<span x-text="lastScanResult.item.planned_boxes"></span> <span x-text="t('cartons')"></span> | 
                <span x-text="t('total')"></span>: <span x-text="lastScanResult?.progress?.totalScanned"></span>/<span x-text="lastScanResult?.progress?.totalPlanned"></span> <span x-text="t('cartons')"></span>
              </div>
            </template>
          </div>
        </div>
      </template>
      <template x-if="!lastScanResult?.success">
        <div>
          ❌ <span x-text="lastScanResult?.error || t('scanFailed')"></span>
          <div class="scan-detail" x-show="lastScanResult?.qrInfo && !lastScanResult?.duplicate">
            <div>
              <span x-text="t('detected')"></span>: <span x-text="t('partNo')"></span> <code x-text="lastScanResult?.qrInfo?.custPn || '-'"></code>
              <span x-show="lastScanResult?.qrInfo?.wo"> | <span x-text="t('wo')"></span> <code x-text="lastScanResult.qrInfo.wo"></code></span>
              <template x-if="lastScanResult?.qrInfo?.boxNum">
                <span> | <span x-text="t('boxNo')"></span> <code x-text="lastScanResult.qrInfo.boxNum + '/' + lastScanResult.qrInfo.totalBoxes"></code></span>
              </template>
              <template x-if="!lastScanResult?.qrInfo?.boxNum">
                <span> | <span x-text="t('singleCarton')"></span></span>
              </template>
            </div>
            <div x-show="lastScanResult?.currentItem" style="margin-top: 4px;">
              ⚠️ <span x-text="t('expected')"></span>: <span x-text="t('partNo')"></span> <code x-text="lastScanResult.currentItem.item_code"></code>
              <span x-show="lastScanResult?.currentItem?.wo_number"> | <span x-text="t('wo')"></span> <code x-text="lastScanResult.currentItem.wo_number"></code></span>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- 所有品项进度 -->
    <div class="all-items-progress" x-show="items.length > 0">
      <h4 x-text="t('allProgress')"></h4>
      <div class="items-progress-list">
        <template x-for="(item, idx) in items" :key="idx">
          <div class="item-progress-row" :class="item.status">
            <div class="item-progress-info">
              <span class="item-progress-seq" x-text="item.sequence + '.'"></span>
              <span class="item-progress-code" x-text="item.item_code"></span>
              <span class="item-progress-name" x-text="item.item_name?.substring(0, 20)"></span>
            </div>
            <div class="item-progress-bar-wrap">
              <div class="progress-bar progress-xs">
                <div class="progress-fill" 
                     :style="'width: ' + (item.planned_boxes > 0 ? (item.scanned_boxes / item.planned_boxes * 100) : 0) + '%'"></div>
              </div>
              <span class="item-progress-count">
                <span x-text="item.scanned_boxes"></span>/<span x-text="item.planned_boxes"></span>
              </span>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- 签名提示 / 完成按钮 -->
    <div class="action-row" x-show="allCompleted">
      <template x-if="confirmation?.status === 'pending_signature'">
        <div class="sign-prompt">
          <div class="sign-prompt-message">
            📝 <span x-text="t('signRequired')"></span>
          </div>
          <button class="btn-primary" @click="showSignModal = true"><span x-text="t('openSignPad')"></span></button>
        </div>
      </template>
      <template x-if="confirmation?.status === 'confirmed'">
        <div>
          <div class="completed-message">
            🎉 <span x-text="t('notifyDone')"></span> <strong x-text="notice?.PickListId"></strong> <span x-text="t('confirmed')"></span>！
            <div class="sign-info" x-show="confirmation?.signed_by">
              ✍️ <span x-text="t('signedBy')"></span> <strong x-text="confirmation?.signed_by"></strong>
            </div>
          </div>
          <button class="btn-primary" @click="reset()"><span x-text="t('nextSearch')"></span></button>
        </div>
      </template>
    </div>

    <!-- 签名 Modal -->
    <div class="sign-modal-overlay" x-show="showSignModal" x-cloak @click.self="showSignModal = false">
      <div class="sign-modal">
        <h3 x-text="t('signTitle')"></h3>
        <div class="sign-name-row">
          <label x-text="t('signerName')"></label>
          <input type="text" x-model="signedBy" :placeholder="t('signerPlaceholder')">
        </div>
        <div class="sign-canvas-wrap">
          <canvas id="signature-pad" width="500" height="200"></canvas>
        </div>
        <div class="sign-actions">
          <button @click="clearSignature()" x-text="t('clearSignature')"></button>
          <button class="btn-primary" @click="submitSignature()" :disabled="submittingSignature || !signedBy.trim()">
            <span x-show="!submittingSignature" x-text="t('confirmSignature')"></span>
            <span x-show="submittingSignature" x-text="t('submitting')"></span>
          </button>
        </div>
        <div class="sign-error" x-show="signError" x-text="signError"></div>
      </div>
    </div>
  </section>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
<script src="https://unpkg.com/alpinejs@3/dist/cdn.min.js" defer></script>
