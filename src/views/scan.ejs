function scannerApp() {
  return {
    lang: 'en',

    t(key, vars) {
      let text = translations[this.lang]?.[key] || translations.en[key] || key;
      if (vars) {
        for (const [k, v] of Object.entries(vars)) {
          text = text.replace(`{${k}}`, v);
        }
      }
      return text;
    },

    toggleLang() {
      this.lang = this.lang === 'en' ? 'zh' : 'en';
      localStorage.setItem('shippingLang', this.lang);
    },

    currentSite: '',
    searchInput: '',
    searching: false,
    searchError: '',
    searchErrorType: '',
    notice: null,
    items: [],
    starting: false,

    confirmationId: null,
    confirmation: null,
    barcode: '',
    allCompleted: false,

    lastScanResult: null,
    feedbackTimer: null,

    // signature
    showSignModal: false,
    signedBy: '',
    signError: '',
    submittingSignature: false,
    signaturePad: null,

    socket: null,
    _scanResultHandler: null,
    _progressUpdateHandler: null,

    init() {
      const saved = localStorage.getItem('shippingLang');
      if (saved === 'zh') this.lang = 'zh';
      const savedSite = localStorage.getItem('shippingSite');
      if (savedSite) this.currentSite = savedSite;

      this.socket = io();
      this.socket.on('connect', () => console.log('[Socket] Connected'));
      this.socket.on('disconnect', () => console.log('[Socket] Disconnected'));
    },

    onSiteChange() {
      localStorage.setItem('shippingSite', this.currentSite);
    },

    async searchNotice() {
      if (!this.searchInput.trim()) return;
      this.searching = true;
      this.searchError = '';
      this.searchErrorType = '';
      try {
        const res = await fetch(`/api/notices/${encodeURIComponent(this.searchInput.trim())}`);
        const json = await res.json();
        if (json.success) {
          if (!json.data.notice) {
            // 出货通知不存在
            this.notice = null;
            this.items = [];
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
            return;
          }
          this.notice = json.data.notice;
          this.items = json.data.items;

          // 站点过滤检查
          if (this.currentSite && this.notice.SiteRef !== this.currentSite) {
            this.searchError = this.t('siteMismatch', { site: this.notice.SiteRef, current: this.currentSite });
            this.searchErrorType = 'site_mismatch';
            return;
          }

          this.searchError = '';
          this.searchErrorType = '';
        } else {
          this.notice = null;
          this.items = [];
          if (json.error === 'not_found') {
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
          } else {
            this.searchError = json.message || json.error || 'Search failed';
            this.searchErrorType = 'error';
          }
        }
      } catch (err) {
        this.searchError = this.lang === 'zh' ? '网络错误: ' + err.message : 'Network error: ' + err.message;
        this.searchErrorType = 'error';
        this.notice = null;
      } finally {
        this.searching = false;
      }
    },

    async startConfirmation() {
      this.starting = true;
      try {
        const res = await fetch('/api/confirmations/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: this.notice.PickListId, operator: 'operator' }),
        });
        const json = await res.json();
        if (json.success) {
          this.confirmationId = json.confirmationId;
          this.confirmation = {
            ...json.notice,
            id: json.confirmationId,
            total_cartons: parseInt(json.notice.total_cartons),
            scanned_boxes: 0,
            status: 'in_progress',
          };
          this.items = json.items;
          this.allCompleted = false;
          this.$nextTick(() => this.$refs.barcodeInput.focus());
          this.socket.emit('join-confirmation', json.confirmationId);
          if (this._scanResultHandler) this.socket.off('scan-result', this._scanResultHandler);
          if (this._progressUpdateHandler) this.socket.off('progress-update', this._progressUpdateHandler);
          this._scanResultHandler = (result) => this.handleScanResult(result);
          this._progressUpdateHandler = (data) => this.handleProgressUpdate(data);
          this.socket.on('scan-result', this._scanResultHandler);
          this.socket.on('progress-update', this._progressUpdateHandler);
        } else {
          if (json.error === 'already_confirmed') {
            this.searchError = this.t('alreadyConfirmed');
            this.searchErrorType = 'already_confirmed';
            this.notice = null;
            this.items = [];
          } else if (json.error === 'not_found') {
            this.searchError = this.t('notFound');
            this.searchErrorType = 'not_found';
            this.notice = null;
            this.items = [];
          } else if (json.confirmationId) {
            alert(this.lang === 'zh' ? '此出货通知已在确认中' : 'This notice is already being confirmed');
            window.location.href = `/scan?id=${json.confirmationId}`;
          } else {
            alert(json.message || json.error);
          }
        }
      } catch (err) {
        alert(this.lang === 'zh' ? '启动失败: ' + err.message : 'Failed: ' + err.message);
      } finally {
        this.starting = false;
      }
    },

    doScan() {
      const barcode = this.barcode.trim();
      if (!barcode || !this.confirmationId) return;
      this.socket.emit('scan-barcode', { confirmationId: this.confirmationId, barcode });
      this.barcode = '';
    },

    handleScanResult(result) {
      this.lastScanResult = result;
      this.playFeedback(result.success);
      if (this.feedbackTimer) clearTimeout(this.feedbackTimer);
      this.feedbackTimer = setTimeout(() => { this.lastScanResult = null; }, 3000);
      if (result.success) {
        this.$nextTick(() => {
          if (this.$refs.barcodeInput && !this.allCompleted) this.$refs.barcodeInput.focus();
        });
      }
    },

    handleProgressUpdate(data) {
      this.confirmation = data.confirmation;
      this.items = data.items;
      this.allCompleted = data.confirmation.status === 'pending_signature' || data.confirmation.status === 'confirmed';
      if (data.confirmation.status === 'pending_signature') {
        this.$nextTick(() => this.initSignaturePad());
      }
      if (data.confirmation.status === 'confirmed') this.playAllComplete();
    },

    playFeedback(success) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination); gain.gain.value = 0.1;
        osc.frequency.value = success ? 880 : 440;
        osc.start(); osc.stop(ctx.currentTime + (success ? 0.1 : 0.2));
      } catch (e) {}
    },

    playAllComplete() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        [523, 659, 784].forEach((freq, i) => {
          const osc = ctx.createOscillator(); const gain = ctx.createGain();
          osc.connect(gain); gain.connect(ctx.destination); gain.gain.value = 0.1;
          osc.frequency.value = freq;
          osc.start(ctx.currentTime + i * 0.15);
          osc.stop(ctx.currentTime + i * 0.15 + 0.2);
        });
      } catch (e) {}
    },

    getProgressPercent() {
      if (!this.confirmation?.total_cartons) return 0;
      return Math.round((this.confirmation.scanned_boxes / this.confirmation.total_cartons) * 100);
    },

    get currentItem() {
      if (!this.items || this.items.length === 0) return null;
      const current = this.items.find(i => i.status !== 'completed');
      return current || this.items[this.items.length - 1];
    },

    formatDate(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      return this.lang === 'zh' ? d.toLocaleDateString('zh-CN') : d.toLocaleDateString('en-US');
    },

    initSignaturePad() {
      this.$nextTick(() => {
        const canvas = document.getElementById('signature-pad');
        if (!canvas) return;
        if (this.signaturePad) { this.signaturePad.off(); this.signaturePad = null; }
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = canvas.offsetHeight * ratio;
        canvas.getContext('2d').scale(ratio, ratio);
        this.signaturePad = new SignaturePad(canvas, {
          backgroundColor: 'rgb(255,255,255)',
          penColor: 'rgb(0,0,0)',
        });
      });
    },

    clearSignature() {
      if (this.signaturePad) this.signaturePad.clear();
    },

    async submitSignature() {
      if (!this.signaturePad || this.signaturePad.isEmpty()) {
        this.signError = this.lang === 'zh' ? '请先签名' : 'Please sign first';
        return;
      }
      if (!this.signedBy.trim()) {
        this.signError = this.lang === 'zh' ? '请输入签名者姓名' : 'Please enter signer name';
        return;
      }
      this.submittingSignature = true;
      this.signError = '';
      try {
        const signature = this.signaturePad.toDataURL('image/png');
        const res = await fetch(`/api/confirmations/${this.confirmationId}/sign`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signature, signedBy: this.signedBy.trim() }),
        });
        const json = await res.json();
        if (json.success) {
          this.confirmation.status = 'confirmed';
          this.confirmation.signed_by = this.signedBy.trim();
          this.showSignModal = false;
          this.playAllComplete();
        } else {
          this.signError = json.error || 'Save failed';
        }
      } catch (err) {
        this.signError = err.message;
      } finally {
        this.submittingSignature = false;
      }
    },

    reset() {
      if (this.socket) {
        this.socket.off('scan-result');
        this.socket.off('progress-update');
      }
      this.searchInput = '';
      this.notice = null;
      this.items = [];
      this.confirmationId = null;
      this.confirmation = null;
      this.barcode = '';
      this.allCompleted = false;
      this.lastScanResult = null;
      this.searchError = '';
      this.searchErrorType = '';
      this.showSignModal = false;
      this.signedBy = '';
      this.signError = '';
      this.submittingSignature = false;
      if (this.signaturePad) { this.signaturePad.off(); this.signaturePad = null; }
    },
  };
}
</script>

